+func (t *Tailscale) watchNotifications() {
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		log.Warnln("[Tailscale](%s) watchNotifications: LocalClient failed: %v", t.Name(), err)
+		return
+	}
+	watcher, err := lc.WatchIPNBus(t.ctx, ipn.NotifyInitialState|ipn.NotifyInitialHealthState)
+	if err != nil {
+		log.Warnln("[Tailscale](%s) watchNotifications: WatchIPNBus failed: %v", t.Name(), err)
+		return
+	}
+	defer watcher.Close()
+
+	snapshot := TailscaleSnapshot{}
+	for {
+		n, err := watcher.Next()
+		if err != nil {
+			return
+		}
+		changed := false
+		if n.State != nil {
+			snapshot.State = n.State.String()
+			changed = true
+			if *n.State == ipn.Running {
+				t.populateStatusFields(&snapshot)
+			}
+		}
+		if n.BrowseToURL != nil {
+			snapshot.AuthURL = *n.BrowseToURL
+			changed = true
+		}
+		if n.Health != nil {
+			warnings := make([]string, 0, len(n.Health.Warnings))
+			for _, w := range n.Health.Warnings {
+				warnings = append(warnings, w.Text)
+			}
+			snapshot.Health = warnings
+			changed = true
+		}
+		if changed {
+			t.emitSnapshot(&snapshot)
+		}
+	}
+}
+
+func (t *Tailscale) populateStatusFields(snapshot *TailscaleSnapshot) {
+	lc, err := t.server.LocalClient()
+	if err != nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(t.ctx, 5*time.Second)
+	defer cancel()
+	st, err := lc.Status(ctx)
+	if err != nil {
+		log.Warnln("[Tailscale](%s) populateStatusFields: %v", t.Name(), err)
+		return
+	}
+	snapshot.IPs = make([]string, 0, len(st.TailscaleIPs))
+	for _, ip := range st.TailscaleIPs {
+		snapshot.IPs = append(snapshot.IPs, ip.String())
+	}
+	if st.Self != nil {
+		snapshot.Hostname = st.Self.HostName
+	}
+	snapshot.Online = st.BackendState == "Running"
+}
+
+func (t *Tailscale) emitSnapshot(snapshot *TailscaleSnapshot) {
+	fn := OnTailscaleNotify
+	if fn == nil {
+		return
+	}
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		log.Warnln("[Tailscale](%s) emitSnapshot: marshal failed: %v", t.Name(), err)
+		return
+	}
+	fn(string(data))
+}
+
+func (t *Tailscale) registerExec() {
+	tailscaleExecOwner = t
+	TailscaleExecFunc = func(requestJSON string) (string, error) {
+		var req struct {
+			Cmd  string          `json:"cmd"`
+			Args json.RawMessage `json:"args,omitempty"`
+		}
+		if err := json.Unmarshal([]byte(requestJSON), &req); err != nil {
+			return "", fmt.Errorf("invalid request: %w", err)
+		}
+		switch req.Cmd {
+		case "logout":
+			return t.execLogout()
+		case "login-interactive":
+			return t.execLoginInteractive()
+		case "status":
+			return t.execStatus()
+		default:
+			return "", fmt.Errorf("unknown command: %s", req.Cmd)
+		}
+	}
+}
+
+func (t *Tailscale) unregisterExec() {
+	if tailscaleExecOwner == t {
+		TailscaleExecFunc = nil
+		tailscaleExecOwner = nil
+	}
+}
